// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  ADMIN
  MODERATOR
  BAKER
  CUSTOMER

  @@map("role_type")
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED

  @@map("recipe_status")
}

enum TagType {
  USER
  PRODUCT
  VARIETY
  ATTRIBUTE

  @@map("tag_type")
}

enum InventoryMovement {
  PURCHASE
  PRODUCTION_USAGE
  PRODUCTION_REVERSAL
  WASTE
  MANUAL_ADJUSTMENT

  @@map("inventory_movement_type")
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT

  @@map("unit_dimension")
}

enum StandardUnit {
  G
  KG
  ML
  L
  UN

  @@map("standard_units")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique @db.VarChar(255)
  name         String  @db.VarChar(100)
  phone        String? @unique @db.VarChar(20)
  pfpUrl       String? @map("profile_picture_url") @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  providerId   String? @unique @map("provider_id") // !==(NULL) -> Login com Google

  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  isActive  Boolean  @default(true) @map("is_active")

  profile BakerProfile?

  refreshTokens RefreshToken[]
  passwordRests PasswordReset[]
  ingredients   Ingredient[]
  recipes       Recipe[]
  createdTags   Tag[]
  inventories   UserInventory[]
  productions   Production[]
  transactions  InventoryTransaction[]
  saves         UserSavedRecipe[]
  reviews       RecipeReview[]

  @@map("user")
}

model RefreshToken {
  id        String @id @default(uuid())
  token     String @unique @db.VarChar(255)
  userId    String @map("user_id")
  sessionId String @map("session_id")

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId])
  @@map("refresh_token")
}

model PasswordReset {
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset")
}

model BakerProfile {
  userId    String  @id @map("user_id")
  bio       String?
  instagram String?

  location     Unsupported("geometry(Point, 4326)")?
  neighborhood String?
  city         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  showcase    ShowcaseRecipe[]
  profileTags UserTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([location], type: Gist)
  @@map("baker_profile")
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  parentId    Int?     @map("parent_id")
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  aliases     String[] // Array de nomes possíveis, evita redundâncias
  description String?  @db.Text
  category    String   @db.VarChar(50)

  baseDimension UnitDimension @default(MASS) @map("base_dimension")
  baseUnit      StandardUnit  @default(G) @map("base_unit")

  creatorId String?  @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // NULL -> Ingrediente Base
  user   User?       @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  parent Ingredient? @relation("IngredientHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children Ingredient[] @relation("IngredientHierarchy")

  conversions IngredientConversion[]

  recipeItems  RecipeItem[]
  inventories  UserInventory[]
  transactions InventoryTransaction[]

  @@unique([creatorId, slug])
  @@map("ingredient")
}

// Tabela de equivalência
model IngredientConversion {
  id           Int    @id @default(autoincrement())
  ingredientId Int    @map("ingredient_id")
  fromUnit     String @map("from_unit") @db.VarChar(30)

  // Fator multiplicador para converter em baseUnit (g, ml ou un)
  // Ex: Para Farinha, fromUnit: CUP -> factorToBase: 120.000 (1 xícara = 120g)
  factorToBase Decimal @map("factor_to_base") @db.Decimal(10, 4)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, fromUnit])
  @@map("ingredient_conversion")
}

model Recipe {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  parentId     String?      @map("parent_id")
  title        String       @db.VarChar(100)
  coverUrl     String?      @map("cover_image_url") @db.VarChar(255)
  instructions Json         @db.JsonB
  baseYield    Decimal      @map("base_yield") @db.Decimal(10, 2) // Rendimento
  yieldUnit    StandardUnit @map("yield_unit") // Unidade de rendimento

  status        RecipeStatus @default(DRAFT)
  totalSaves    Int          @default(0) @map("total_saves")
  totalReviews  Int          @default(0) @map("total_reviews")
  averageRating Decimal      @default(0.00) @map("average_rating") @db.Decimal(3, 2)

  profitMargin    Decimal @default(30.00) @map("profit_margin_percent") @db.Decimal(5, 2) // Margem de lucro
  overhead        Decimal @default(10.00) @map("overhead_percent") @db.Decimal(5, 2) // Custos fixos
  prepTimeMinutes Int     @default(0) @map("prep_time_minutes")
  hourlyLabor     Decimal @default(0.00) @map("hourly_labor_rate") @db.Decimal(10, 2)
  packagingCost   Decimal @default(0.00) @map("packaging_cost") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // NULL -> Receita Base (Parent):
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent Recipe? @relation("RecipeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children Recipe[] @relation("RecipeHierarchy")

  items      RecipeItem[] @relation("RecipeToItems")
  usedAsItem RecipeItem[] @relation("SubRecipeToItems")

  tags            RecipeTag[]
  productions     Production[]
  saves           UserSavedRecipe[]
  reviews         RecipeReview[]
  showcaseRecipes ShowcaseRecipe[]

  @@index([userId])
  @@map("recipe")
}

model Tag {
  id   Int     @id @default(autoincrement())
  name String  @unique @db.VarChar(50)
  type TagType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  creatorId String?  @map("creator_id")

  user User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  users   UserTag[]
  recipes RecipeTag[]

  @@map("tag")
}

model UserTag {
  userId String @map("user_id")
  tagId  Int    @map("tag_id")

  tag     Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  profile BakerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, tagId])
  @@map("user_tag")
}

model RecipeTag {
  recipeId String @map("recipe_id")
  tagId    Int    @map("tag_id")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@map("recipe_tag")
}

// Bill of Material: Substitue a relação antiga, permitindo sub-receitas como item de receita
model RecipeItem {
  id       String @id @default(uuid())
  recipeId String @map("recipe_id")

  // Exclusividade mútua (XOR): preencha um ou outro
  ingredientId Int?    @map("ingredient_id")
  subRecipeId  String? @map("sub_recipe_id")

  quantity Decimal      @map("quantity") @db.Decimal(10, 3) // Sempre salvo em unidade métrica
  unit     StandardUnit

  // Apoio empírico
  displayQuantity Decimal? @map("display_quantity") @db.Decimal(10, 2) // e.g.: 2
  displayUnit     String?  @map("display_unit") @db.VarChar(30) // e.g.: Xícaras

  sortOrder Int     @default(0) @map("sort_order")
  notes     String? @db.VarChar(255)

  recipe     Recipe      @relation("RecipeToItems", fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipe  Recipe?     @relation("SubRecipeToItems", fields: [subRecipeId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
  @@index([subRecipeId])
  @@map("recipe_item")
}

model UserInventory {
  userId          String   @map("user_id")
  ingredientId    Int      @map("ingredient_id")
  currentQuantity Decimal  @default(0.000) @map("current_quantity") @db.Decimal(10, 3)
  minQuantity     Decimal? @map("min_quantity") @db.Decimal(10, 3)

  costPerBaseUnit Decimal @default(0.000000) @map("cost_per_base_unit") @db.Decimal(12, 6)

  expirationDate DateTime? @map("expiration_date") @db.Date

  lastUpdated DateTime @updatedAt @map("last_updated") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([userId, ingredientId])
  @@map("user_inventory")
}

model Production {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  recipeId       String    @map("recipe_id")
  yieldProduced  Decimal   @map("yield_produced") @db.Decimal(10, 2) // Rendimento Gerado
  productionDate DateTime  @default(now()) @map("production_date") @db.Timestamptz(3)
  expirationDate DateTime? @map("expiration_date") @db.Date
  canceledAt     DateTime? @map("canceled_at") @db.Timestamptz(3)

  ingredientCost Decimal @default(0.00) @map("ingredient_cost") @db.Decimal(10, 2) // Custo somado dos insumos
  laborCost      Decimal @default(0.00) @map("labor_cost") @db.Decimal(10, 2) // Custo de mão de obra aplicado
  overheadCost   Decimal @default(0.00) @map("overhead_cost") @db.Decimal(10, 2) // Custos fixos/indiretos rateados
  packagingCost  Decimal @default(0.00) @map("packaging_cost") @db.Decimal(10, 2) // Custo de embalagem no momento
  totalCost      Decimal @default(0.00) @map("total_cost") @db.Decimal(10, 2) // Soma de todos os custos
  unitCost       Decimal @default(0.00) @map("unit_cost") @db.Decimal(10, 4) // totalCost / yieldProduced

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe       Recipe                 @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]

  @@index([userId, productionDate])
  @@map("production")
}

// Livro-Razão
model InventoryTransaction {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  ingredientId Int     @map("ingredient_id")
  productionId String? @map("production_id")

  transactionType InventoryMovement @map("transaction_type")
  quantityChanged Decimal           @map("quantity_changed") @db.Decimal(10, 3)
  measurementUnit StandardUnit      @map("measurement_unit")

  // Snapshot Contábil do Livro-Razão
  unitCost  Decimal @default(0.0000) @map("unit_cost") @db.Decimal(10, 4) // Custo unitário do insumo no momento
  totalCost Decimal @default(0.00) @map("total_cost") @db.Decimal(10, 2) // quantityChanged * unitCost

  expirationDate DateTime? @map("expiration_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  production Production? @relation(fields: [productionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ingredientId])
  @@map("inventory_transaction")
}

model ShowcaseRecipe {
  userId    String   @map("profile_id")
  recipeId  String   @map("recipe_id")
  order     Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile BakerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  recipe  Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("showcase_recipe")
}

model UserSavedRecipe {
  userId   String @map("user_id")
  recipeId String @map("recipe_id")

  savedAt DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("user_saved_recipe")
}

model RecipeReview {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  recipeId String @map("recipe_id")
  rating   Int // Travamento de 1 a 5 no tratamento de dados

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@map("recipe_review")
}
