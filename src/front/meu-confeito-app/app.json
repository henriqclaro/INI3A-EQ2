{
  "expo": {
    "slug": "meu-confeito-app",
    "name": "Meu Confeito",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meuconfeitoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cti.meuconfeitoapp"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6EDDC",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "permissions": ["INTERNET"],
      "predictiveBackGestureEnabled": false,
      "package": "com.cti.meuconfeitoapp",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F7",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#180E10"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/26-meuconfeito"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d286cac0-a126-4758-a295-7dd2170c5619"
      }
    },
    "owner": "henriqclaro"
  }
}
